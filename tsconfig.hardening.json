{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "next-env.d.ts",
    "src/lib/security/secret-codec.ts",
    "src/lib/ai/context-budget.ts",
    "src/lib/ai/openai-response.ts",
    "src/lib/ai/openai-sse.ts",
    "src/lib/security/device-identity.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
