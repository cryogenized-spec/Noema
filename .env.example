# Agent provider configuration
# mock | openai
AGENT_PROVIDER=mock

# Optional OpenAI settings (only needed when AGENT_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Disabled in production by default. Only enable for controlled local BYOK tests.
NOEMA_ENABLE_BYOK_AGENT_PROXY=false

# Same opt-in development gateway flag protects STT. Never expose a server-paid key.
